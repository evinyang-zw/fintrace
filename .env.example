DATABASE_URL=postgresql://fintrace:fintrace@localhost:5433/fintrace
# SEC requires a User-Agent that identifies you and a way to contact you.
SEC_USER_AGENT="FinTrace research your-name@example.com"
FINTRACE_DATA_DIR=data

# ===== LLM（W2 起）=====
# 任意 OpenAI 兼容端点；换模型只改这三行，不改代码。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# 不要把真实密钥写进这个文件（它在 Git 里）；复制到 .env 再填。
LLM_API_KEY=
LLM_TEMPERATURE=0
# 单次请求超时与重试次数：p95 的尾巴主要是 20–40s 的 provider 抖动
LLM_TIMEOUT_S=25
LLM_ATTEMPTS=2
# 对冲请求：3.5s 未返回就并行发第二次，取先到的；0 关闭（A/B 用）
LLM_HEDGE_AFTER_S=3.5

# 思考模式：disabled 时 temperature 才生效；W3 做对照时可改 enabled
LLM_THINKING=disabled

# ===== 检索（W3 起）=====
# 一个供应商同时提供 embedding 与 rerank（阿里云百炼）。
# 默认走原生端点（/api/v1/services/...）；若换成 OpenAI 兼容端点（以 /embeddings 结尾），
# 客户端会按 URL 自动切换请求格式，不需要改代码。
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://ws-c4m8892f6huk1yth.cn-beijing.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
RERANK_URL=https://ws-c4m8892f6huk1yth.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=gte-rerank-v2

# bm25 | dense | hybrid | hybrid_rerank
# 缺 key 或没有向量时会显式降级（报告与 trace 里能看到），不会静默假装跑过。
RETRIEVAL_TIER=bm25

# ===== 编排（W4 起）=====
# inproc: 工具函数进程内调用（默认，最快）
# mcp:    工具跑在独立 mcp_server 进程（stdio；只读 DB + embedding/rerank 白名单）
FINTRACE_TOOL_BACKEND=inproc

# 人工审阅：never（评测默认，不中断）| always（演示，每道题都停）
FINTRACE_REVIEW_MODE=never
